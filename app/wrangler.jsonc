{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare nombro el worker con el nombre del repo al importarlo; se
  // respeta ese nombre para no crear un worker duplicado en cada deploy.
  "name": "ee-solutions-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-03-01",
  // nodejs_compat lo requiere el adaptador de OpenNext; sin él el worker
  // no arranca. global_fetch_strictly_public evita que las llamadas del
  // servidor a Supabase se resuelvan dentro del propio worker.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
